{
  "name": "impacto33-mvp",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"next dev --port 3000\" \"npm run dev:server\"",
    "dev:next": "next dev --port 3000",
    "dev:turbo": "next dev --port 3000",
    "dev:server": "NODE_ENV=development EXPRESS_PORT=3001 tsx watch server/_core/index.ts",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm dev:server\"",
    "build": "cross-env NODE_ENV=production next build",
    "build:server": "esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "deploy:build": "npm run build && npm run build:server",
    "start": "next start",
    "start:next": "next start --hostname 127.0.0.1 --port 3000",
    "start:server": "NODE_ENV=production node dist/index.js",
    "build:sitemap": "node generate-sitemap.mjs && node generate-sitemap-products.mjs",
    "build:sitemap:products": "node generate-sitemap-products.mjs",
    "lint": "eslint .",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "builder:review": "node scripts/review-builder-zip.mjs",
    "format": "prettier --write .",
    "db:push": "drizzle-kit generate && drizzle-kit migrate"
  },
